{
  "name": "@zettl/editor",
  "version": "0.0.0",
  "description": "Cross-platform note editor with Markdown, tagging, and local-first storage, built with Vue and Electron.",
  "keywords": [
    "zettl",
    "notes",
    "markdown",
    "editor",
    "vue",
    "electron",
    "offline-first",
    "tagging",
    "local-storage",
    "cross-platform"
  ],
  "author": "Dmitry Dobrynin <dd@tovarisch.engineer>",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:dd/zettl-editor.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/dd/zettl-editor/issues"
  },
  "homepage": "https://github.com/dd/zettl-editor#readme",
  "private": true,
  "main": "dist/electron/main.js",
  "files": [
    "dist/vite/**",
    "dist/electron/**",
    "README.md"
  ],
  "build": {
    "appId": "com.zettl.editor",
    "productName": "Zettl Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/vite/**",
      "dist/electron/**"
    ],
    "extraMetadata": {
      "main": "dist/electron/main.js"
    },
    "win": {
      "target": "nsis"
    }
  },
  "scripts": {
    "build": "run-s type-check build:main build:renderer",
    "build:main": "tsc -p electron/tsconfig.json",
    "build:renderer": "vite build",
    "dev": "concurrently \"vite\" \"npm:watch:main\" \"cross-env NODE_ENV=development electron dist/electron/main.js\"",
    "watch:main": "tsc -p electron/tsconfig.json --watch",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "start": "cross-env NODE_ENV=production electron dist/electron/main.js",
    "release": "electron-builder"
  },
  "dependencies": {
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.22.0",
    "eslint-plugin-oxlint": "^0.16.0",
    "eslint-plugin-vue": "~10.0.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^0.16.0",
    "prettier": "3.5.3",
    "typescript": "~5.8.0",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue-tsc": "^2.2.8"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
