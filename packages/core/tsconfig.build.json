{
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"declarationDir": "dist",
		"emitDeclarationOnly": false,
		"outDir": "dist",
		"module": "ESNext",
		"moduleResolution": "node",
		"target": "ES2020",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"composite": true
	},
	"include": ["src"]
}
