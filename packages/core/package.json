{
  "name": "@zettl/core",
  "version": "0.0.0",
  "description": "Core logic and data models for the Zettl note system",
  "keywords": [
    "zettl",
    "notes",
    "core",
    "markdown",
    "workspace"
  ],
  "author": "Dmitry Dobrynin <dd@tovarisch.engineer>",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:dd/zettl-editor.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./types": { "types": "./dist/types.d.ts", "default": "./dist/types.js" }
  },
  "sideEffects": false,
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
